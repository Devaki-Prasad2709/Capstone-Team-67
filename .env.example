# Kafka address used by Python producers/consumers and Spark.
# Host machine: localhost:9092
# Second machine: reachable host IP (Wi-Fi LAN or Tailscale 100.x):9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Address Kafka advertises to clients. Set this to the Windows Wi-Fi IPv4 for
# a LAN test or the Windows Tailscale 100.x IP for an internet-separated test.
KAFKA_ADVERTISED_HOST=localhost

# Dataset folders on the removable drive. Quoting is optional unless spaces exist.
SOCIAL_DATASET_PATH=D:/Capstone-Team-67/datasets/Social/CrisisMMD_v2.0/crisismmd_datasplit_all/crisismmd_datasplit_all
DRONE_DATASET_PATH=D:/Capstone-Team-67/datasets/Drone/ISBDA/train
ISBDA_DATASET_PATH=D:/Capstone-Team-67/datasets/Drone/ISBDA
SATELLITE_DATASET_PATH=D:/Capstone-Team-67/datasets/Satellite/xBD/test/images
SPACENET8_DATASET_PATH=D:/Capstone-Team-67/datasets/Satellite/spacenet8/Spacenet8_Louisiana-East_Trainingtar
GIS_DATASET_PATH=D:/Capstone-Team-67/datasets/GIS/harvey/imagery

# Frozen scenario files used by the graph layer and dashboard map.
FINAL_SCENARIO_PATH=scenarios/louisiana_east_flood/scenario.json
MAP_SCENARIO_GEOJSON=scenarios/louisiana_east_flood/gis/infrastructure.geojson

SOCIAL_STREAM_DELAY=1
DRONE_STREAM_DELAY=0.5
SATELLITE_STREAM_DELAY=5
GIS_STREAM_DELAY=2

# 10 MiB development ceiling. Base64 adds roughly 33 percent overhead.
KAFKA_MAX_MESSAGE_BYTES=10485760
SATELLITE_JPEG_QUALITY=85
SATELLITE_CHANGE_CONSUMER_GROUP=satellite-change-v1
SATELLITE_CHANGE_STARTING_OFFSETS=latest
SATELLITE_CHANGE_GRID_SIZE=8
LOG_LEVEL=INFO

# Image transfer mode:
#   base64         - simplest; complete image travels through Kafka
#   object_storage - recommended; image goes to S3/MinIO and Kafka carries a URI
IMAGE_TRANSFER_MODE=base64

# S3-compatible object storage. These values also work with the included MinIO
# service. For internet testing through Tailscale, replace localhost with the
# Kafka host's stable 100.x.x.x Tailscale IP on BOTH computers.
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=disaster-images
OBJECT_STORAGE_ACCESS_KEY=disasteradmin
OBJECT_STORAGE_SECRET_KEY=change-this-development-password
OBJECT_STORAGE_PRESIGNED_EXPIRY=3600

# The MinIO container uses the same credentials. Change the password before
# sharing access and keep the real .env file private.
MINIO_ROOT_USER=disasteradmin
MINIO_ROOT_PASSWORD=change-this-development-password

# Persistent image deduplication. SHA-256 exact dedup applies to all images.
# Near-duplicate pHash defaults to drone only so satellite before/after pairs
# are never accidentally suppressed.
IMAGE_DEDUPLICATION_ENABLED=true
NEAR_DUPLICATE_ENABLED=true
NEAR_DUPLICATE_SOURCES=drone
PHASH_DISTANCE_THRESHOLD=6
DEDUP_LOOKBACK_RECORDS=500
DEDUP_DATABASE_PATH=storage/dedup/image_fingerprints.sqlite3

# Spark controls
SPARK_MASTER=local[*]
SPARK_STARTING_OFFSETS=latest
DISASTER_KEYWORDS=flood,fire,earthquake,rescue,injured,damage,storm,hurricane

# AI damage detector. CPU works out of the box; use AI_DEVICE=0 for the first CUDA GPU.
AI_MODEL_PATH=ai/computer_vision/artifacts/drone_detector/weights/best.pt
AI_CONSUMER_GROUP=disaster-ai-drone-v1
AI_STARTING_OFFSETS=latest
AI_IMAGE_SIZE=640
AI_CONFIDENCE_THRESHOLD=0.25
AI_DEVICE=
AI_ENABLE_MOTION_FILTER=true
AI_ENABLE_QUALITY_FILTER=true
AI_ENABLE_NEAR_DEDUP=false
AI_MOTION_THRESHOLD=5000
AI_BLUR_THRESHOLD=100
AI_PHASH_THRESHOLD=5
AI_PHASH_WINDOW=20
AI_ALLOW_LOCAL_PATHS=false
